{
  "name": "slice",
  "version": "0.1.0",
  "description": "Deterministic responsive QA for coding agents",
  "bin": {
    "slice": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "fmt": "oxfmt --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" tsdown.config.ts package.json tsconfig.json",
    "fmt:check": "oxfmt --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" tsdown.config.ts package.json tsconfig.json",
    "lint": "oxlint --deny-warnings --vitest-plugin src test scripts tsdown.config.ts",
    "lint:fix": "oxlint --fix --vitest-plugin src test scripts tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run test/boundary.test.ts test/overflow.test.ts test/selector.test.ts",
    "test:integration": "vitest run test/integration.test.ts",
    "validate:package": "node scripts/validate-package.mjs && npm pack --dry-run --ignore-scripts",
    "check:fast": "npm run fmt:check && npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run validate:package",
    "smoke": "node scripts/lab.mjs",
    "lab": "npm run check:fast && npm run test:integration && npm run smoke",
    "postinstall": "playwright install chromium",
    "demo": "npm run build --silent && node scripts/demo.mjs",
    "demo:serve": "node scripts/demo-server.mjs",
    "demo:scan": "npm run build --silent && node dist/cli.mjs http://127.0.0.1:4173/broken.html --widths 320,390,430,768,1024 --out .slice/demo-manual",
    "demo:visual": "npm run build --silent && node scripts/demo-responsively.mjs"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "picocolors": "^1.1.1",
    "playwright": "^1.63.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
